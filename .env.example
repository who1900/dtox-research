# pipeline
SEMANTIC_SCHOLAR_API_KEY=          # optional, lifts the shared 1 req/s pool
DTOX_DATA_DIR=./data
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=papers_fulltext
EMBED_URL=http://127.0.0.1:8005/embed
EMBED_BATCH_URL=http://127.0.0.1:8005/embed_batch
FTS_DB_PATH=./data/fts.db

# mcp server -> internal api
RESEARCH_API_KEY=                  # a key from the api's keys.json
RESEARCH_API_BASE=http://127.0.0.1:8010
RESEARCH_KEYS_PATH=./keys.json
MCP_REGISTRY_WRITES_ENABLED=0      # public endpoints must stay read-only

# api -> reranker (optional, off by default)
RERANK_ENABLED=0
RERANK_URL=http://127.0.0.1:8005/rerank

# ops alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
